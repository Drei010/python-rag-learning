# ------------------------------------------------------------------------------
# Model mode
# ------------------------------------------------------------------------------
# Use "local" for Ollama, or "hosted" for OpenAI/Groq-compatible APIs.
LLM_MODE=local

# ------------------------------------------------------------------------------
# Local model (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_LLM_MODEL=gemma4

# ------------------------------------------------------------------------------
# Hosted model
# ------------------------------------------------------------------------------
# Used only when LLM_MODE=hosted.
HOSTED_LLM_PROVIDER=openai
HOSTED_LLM_MODEL=gpt-4o-mini
HOSTED_LLM_API_KEY=
HOSTED_LLM_BASE_URL=
HOSTED_LLM_TEMPERATURE=1
HOSTED_LLM_TOP_P=1
HOSTED_LLM_MAX_TOKENS=2048
GROQ_REASONING_EFFORT=medium

# Optional provider-specific fallback keys.
OPENAI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------------------------
# Use "local" for Ollama embeddings, "custom" for deterministic hash embeddings,
# or "hosted" for hosted embeddings.
EMBEDDING_MODE=local
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_DIMENSIONS=384
HOSTED_EMBEDDING_PROVIDER=openai
HOSTED_EMBEDDING_MODEL=text-embedding-3-small
HOSTED_EMBEDDING_API_KEY=
HOSTED_EMBEDDING_BASE_URL=

# ------------------------------------------------------------------------------
# Chunking model
# ------------------------------------------------------------------------------
# Use "local" for Ollama chunking, or "hosted" for a hosted chunking model.
# If unset, chunking follows LLM_MODE.
CHUNKING_MODE=local
OLLAMA_CHUNKING_MODEL=gemma4
HOSTED_CHUNKING_PROVIDER=openai
HOSTED_CHUNKING_MODEL=gpt-4o-mini
HOSTED_CHUNKING_API_KEY=
HOSTED_CHUNKING_BASE_URL=
HOSTED_CHUNKING_TEMPERATURE=1
HOSTED_CHUNKING_TOP_P=1
HOSTED_CHUNKING_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# Retrieval and chat history
# ------------------------------------------------------------------------------
RETRIEVER_K=5
RETRIEVER_K_PER_SOURCE=3
MAX_CHAT_HISTORY_MESSAGES=12
MAX_CHAT_HISTORY_CONTENT_CHARS=2000

# ------------------------------------------------------------------------------
# File storage
# ------------------------------------------------------------------------------
FILE_STORAGE_BACKEND=local
DATA_DIR=data

AWS_S3_BUCKET=your-bucket-name
AWS_S3_PREFIX=rag-files
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STORAGE_CACHE_DIR=.storage_cache
